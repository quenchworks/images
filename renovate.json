{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended", "helpers:pinGitHubActionDigests"],
  "labels": ["dependencies"],
  "packageRules": [
    {
      "description": "Keep GitHub Actions pinned to commit SHAs",
      "matchManagers": ["github-actions"],
      "pinDigests": true
    }
  ]
}
