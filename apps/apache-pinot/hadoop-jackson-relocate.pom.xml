<?xml version="1.0" encoding="UTF-8"?>
<!-- Relocates jackson 2.18.12 into hadoop-client-runtime's namespace, to replace the 2.12.7 copy
     hadoop 3.4.x shades (no fix on 2.12). The output's classes overwrite that copy in pinot-parquet. -->
<project xmlns="http://maven.apache.org/POM/4.0.0">
  <modelVersion>4.0.0</modelVersion>
  <groupId>quench</groupId>
  <artifactId>hadoop-shaded-jackson</artifactId>
  <version>2.18.12</version>
  <properties><maven.compiler.release>8</maven.compiler.release></properties>
  <dependencies>
    <dependency><groupId>com.fasterxml.jackson.core</groupId><artifactId>jackson-core</artifactId><version>2.18.12</version></dependency>
    <dependency><groupId>com.fasterxml.jackson.core</groupId><artifactId>jackson-databind</artifactId><version>2.18.12</version></dependency>
    <dependency><groupId>com.fasterxml.jackson.core</groupId><artifactId>jackson-annotations</artifactId><version>2.18.12</version></dependency>
    <dependency><groupId>com.fasterxml.jackson.jaxrs</groupId><artifactId>jackson-jaxrs-base</artifactId><version>2.18.12</version></dependency>
    <dependency><groupId>com.fasterxml.jackson.jaxrs</groupId><artifactId>jackson-jaxrs-json-provider</artifactId><version>2.18.12</version></dependency>
    <dependency><groupId>com.fasterxml.jackson.module</groupId><artifactId>jackson-module-jaxb-annotations</artifactId><version>2.18.12</version></dependency>
  </dependencies>
  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-shade-plugin</artifactId>
        <version>3.6.2</version>
        <executions>
          <execution>
            <phase>package</phase>
            <goals><goal>shade</goal></goals>
            <configuration>
              <!-- jackson only: the javax/jakarta APIs these modules use stay where hadoop already has them -->
              <artifactSet><includes><include>com.fasterxml.jackson.*:*</include></includes></artifactSet>
              <relocations>
                <relocation>
                  <pattern>com.fasterxml.jackson</pattern>
                  <shadedPattern>org.apache.hadoop.shaded.com.fasterxml.jackson</shadedPattern>
                </relocation>
                <relocation>
                  <pattern>javax.ws.rs</pattern>
                  <shadedPattern>org.apache.hadoop.shaded.javax.ws.rs</shadedPattern>
                </relocation>
                <relocation>
                  <pattern>javax.xml.bind</pattern>
                  <shadedPattern>org.apache.hadoop.shaded.javax.xml.bind</shadedPattern>
                </relocation>
                <relocation>
                  <pattern>javax.activation</pattern>
                  <shadedPattern>org.apache.hadoop.shaded.javax.activation</shadedPattern>
                </relocation>
              </relocations>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
